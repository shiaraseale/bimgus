# Clash of Clans API Credentials
# Get your token at https://developer.clashofclans.com
COC_API_TOKEN=your_clash_of_clans_api_token_here
# Target Clan Tag (with or without #, e.g. #ABC123)
COC_CLAN_TAG=#ABC123
# Optional: Proxy URL if routing requests via a static IP proxy (e.g. https://coc-proxy.yourdomain.com)
COC_API_BASE_URL=https://api.clashofclans.com/v1

# Discord Webhook URLs (can also be configured via Firestore config collection)
DISCORD_WEBHOOK_CLAN_ACTIVITY=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_WAR_ROOM=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_CWL_HUB=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_RAID_WEEKEND=https://discord.com/api/webhooks/...
DISCORD_WEBHOOK_CLAN_GAMES=https://discord.com/api/webhooks/...

# Discord Bot & Slash Command Interactions
DISCORD_CLIENT_ID=your_discord_app_client_id
DISCORD_CLIENT_SECRET=your_discord_app_client_secret
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_PUBLIC_KEY=your_app_public_key
DISCORD_GUILD_ID=your_discord_server_id
DISCORD_COLEADER_ROLE_ID=your_co_leader_role_id
DISCORD_LEADER_ROLE_ID=your_leader_role_id

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: API warming ping URL to keep the api Cloud Function warm
API_PING_URL=https://us-central1-your-project-id.cloudfunctions.net/api/api/ping

