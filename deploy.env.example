# Proxy VM settings, read by deploy-proxy.sh and proxy/apply-to-gce.sh.
# Copy to deploy.env (git-ignored) and fill in your own values.
GCP_PROJECT_ID=your-project-id
# The e2-micro free tier covers us-west1, us-central1 and us-east1
GCP_REGION=your-region
GCP_ZONE=your-zone
PROXY_VM_NAME=your-vm-name
PROXY_NETWORK_TAG=your-network-tag
PROXY_FIREWALL_RULE=your-firewall-rule
PROXY_STATIC_IP_NAME=your-static-ip-name
# Hostname Caddy gets an HTTPS certificate for, e.g. <ip-with-dashes>.sslip.io or proxy.yourdomain.com
PROXY_HOSTNAME=your-ip-with-dashes.sslip.io
